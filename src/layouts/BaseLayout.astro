---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = "TahaRb",
  description = "TahaRb | Helping People Learn, Build & Grow.",
  canonical,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <link
    rel="icon"
    type="image/svg+xml"
    href="/favicon.svg"
  />

  <title>{title}</title>

  <meta
    name="description"
    content={description}
  />

  {canonical && (
    <link
      rel="canonical"
      href={canonical}
    />
  )}

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  />

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />

  <!-- Google Fonts: single request -->

  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
    rel="stylesheet"
  />

</head>

<body>

  <Navbar />

  <main>
    <slot />
  </main>

  <Footer />

  <!-- BACK TO TOP -->

  <button
    id="back-to-top"
    aria-label="Back to top"
  >
    ↑
  </button>

  <script>

    /*
     * SCROLL REVEAL
     */

    const revealElements =
      document.querySelectorAll(
        "main section, main .card, main .resource"
      );

    revealElements.forEach((element) => {
      element.classList.add("reveal");
    });

    const revealObserver =
      new IntersectionObserver(
        (entries, observer) => {

          entries.forEach((entry) => {

            if (!entry.isIntersecting) return;

            entry.target.classList.add(
              "revealed"
            );

            observer.unobserve(
              entry.target
            );

          });

        },
        {
          threshold: 0.12,
        }
      );

    revealElements.forEach((element) => {
      revealObserver.observe(element);
    });


    /*
     * BACK TO TOP
     */

    const backToTop =
      document.getElementById(
        "back-to-top"
      );

    function updateBackToTop() {

      if (!backToTop) return;

      if (window.scrollY > 500) {

        backToTop.classList.add(
          "visible"
        );

      } else {

        backToTop.classList.remove(
          "visible"
        );

      }

    }

    window.addEventListener(
      "scroll",
      updateBackToTop,
      { passive: true }
    );

    updateBackToTop();

    backToTop?.addEventListener(
      "click",
      () => {

        window.scrollTo({
          top: 0,
          behavior: "smooth",
        });

      }
    );

  </script>

</body>
</html>


<style is:global>

:root {

  --background: #F8F5F1;

  --surface: #FFFFFF;

  --text: #111111;

  --text-light: #6B6B6B;

  --border: #ECE7E0;

  --container: 1150px;

  --radius: 18px;

  --shadow:
    0 12px 40px rgba(0,0,0,.06);

  --transition: .28s ease;

}


/* RESET */

* {

  margin: 0;

  padding: 0;

  box-sizing: border-box;

}


/* HTML */

html {

  scroll-behavior: smooth;

}


/* BODY */

body {

  background:
    var(--background);

  color:
    var(--text);

  font-family:
    "Inter",
    sans-serif;

  -webkit-font-smoothing:
    antialiased;

  text-rendering:
    optimizeLegibility;

}


/* MAIN */

main {

  min-height: 70vh;

}


/* CONTAINER */

.container {

  width:
    min(
      var(--container),
      92%
    );

  margin:
    auto;

}


/* HEADINGS */

h1,
h2,
h3,
h4 {

  font-family:
    "Cormorant Garamond",
    serif;

  font-weight:
    500;

  line-height:
    1.15;

  letter-spacing:
    -.02em;

}


h1 {

  font-size:
    clamp(
      3rem,
      7vw,
      5rem
    );

}


h2 {

  font-size:
    clamp(
      2.3rem,
      5vw,
      3.5rem
    );

}


h3 {

  font-size:
    1.6rem;

}


/* PARAGRAPHS */

p {

  color:
    var(--text-light);

  line-height:
    1.8;

}


/* LINKS */

a {

  color:
    inherit;

  text-decoration:
    none;

  transition:
    var(--transition);

}


/* IMAGES */

img {

  display:
    block;

  max-width:
    100%;

}


/* BUTTONS */

button {

  font:
    inherit;

  cursor:
    pointer;

  transition:
    var(--transition);

}


/* SECTIONS */

section {

  padding:
    120px 0;

}


/* CARDS */

.card {

  background:
    var(--surface);

  border:
    1px solid var(--border);

  border-radius:
    var(--radius);

  transition:
    var(--transition);

}


.card:hover {

  transform:
    translateY(-8px);

  box-shadow:
    var(--shadow);

  border-color:
    #DDD5CC;

}


/* PRIMARY BUTTON */

.button,
.primary {

  display:
    inline-flex;

  align-items:
    center;

  justify-content:
    center;

  gap:
    .5rem;

  background:
    #111;

  color:
    #fff;

  padding:
    16px 34px;

  border-radius:
    999px;

  transition:
    var(--transition);

}


.button:hover,
.primary:hover {

  transform:
    translateY(-3px);

  box-shadow:
    0 12px 30px
    rgba(0,0,0,.15);

}


/* SECONDARY BUTTON */

.secondary {

  display:
    inline-flex;

  align-items:
    center;

  justify-content:
    center;

  padding:
    16px 34px;

  border-radius:
    999px;

  border:
    1px solid #111;

  transition:
    var(--transition);

}


.secondary:hover {

  background:
    #111;

  color:
    #fff;

  transform:
    translateY(-3px);

}


/* SCROLL REVEAL */

.reveal {

  opacity:
    0;

  transform:
    translateY(24px);

  transition:
    opacity .7s ease,
    transform .7s ease;

}


.reveal.revealed {

  opacity:
    1;

  transform:
    translateY(0);

}


/* BACK TO TOP */

#back-to-top {

  position:
    fixed;

  right:
    28px;

  bottom:
    28px;

  width:
    48px;

  height:
    48px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  border:
    1px solid #DDD5CC;

  border-radius:
    50%;

  background:
    #111;

  color:
    #fff;

  font-size:
    1.2rem;

  opacity:
    0;

  visibility:
    hidden;

  transform:
    translateY(15px);

  transition:
    opacity .3s ease,
    visibility .3s ease,
    transform .3s ease;

  z-index:
    900;

}


#back-to-top.visible {

  opacity:
    1;

  visibility:
    visible;

  transform:
    translateY(0);

}


#back-to-top:hover {

  transform:
    translateY(-4px);

  box-shadow:
    0 10px 25px
    rgba(0,0,0,.18);

}


/* REDUCED MOTION */

@media (
  prefers-reduced-motion: reduce
) {

  .reveal {

    opacity:
      1;

    transform:
      none;

    transition:
      none;

  }

}


/* MOBILE */

@media (max-width: 768px) {

  section {

    padding:
      80px 0;

  }

  #back-to-top {

    right:
      18px;

    bottom:
      18px;

    width:
      44px;

    height:
      44px;

  }

}

</style>