<section class="hero">

    <div class="container">

        <p class="eyebrow">
            Founder • Builder • Entrepreneur
        </p>

        <h1>
            Helping people learn,<br>
            build & grow.
        </h1>

        <p class="description">
            Practical articles on self-development,
            artificial intelligence, productivity,
            entrepreneurship, and digital tools to help
            you create a better future.
        </p>

        <div class="buttons">

            <a href="/articles" class="primary">
                Read Articles
            </a>

            <a href="/resources" class="secondary">
                Explore Resources
            </a>

        </div>

    </div>

</section>

<style>

.hero{

    background:#F8F5F1;

    min-height:78vh;

    display:flex;
    align-items:center;
}

.container{

    width:min(900px,92%);
    margin:auto;
}

.eyebrow{

    font-size:.9rem;
    letter-spacing:2px;
    text-transform:uppercase;
    color:#8B8176;

    margin-bottom:25px;
}

h1{

    font-size:clamp(3rem,8vw,5.5rem);

    line-height:1.05;

    font-weight:500;

    color:#111;

    margin-bottom:30px;

    font-family:Georgia, serif;
}

.description{

    max-width:650px;

    font-size:1.18rem;

    line-height:1.9;

    color:#555;

    margin-bottom:50px;
}

.buttons{

    display:flex;

    gap:18px;

    flex-wrap:wrap;
}

.primary{

    background:#111;

    color:white;

    padding:16px 34px;

    text-decoration:none;

    border-radius:50px;

    transition:.3s;
}

.primary:hover{

    background:#333;
}

.secondary{

    border:1px solid #CFC7BC;

    color:#111;

    padding:16px 34px;

    border-radius:50px;

    text-decoration:none;

    transition:.3s;
}

.secondary:hover{

    background:#ECE7E0;
}

</style>