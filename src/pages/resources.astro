---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Resources | TahaRb"
  description="A curated collection of books, AI tools, software and websites to help you learn, build and grow."
>

<section class="hero">

  <div class="container">

    <p class="eyebrow">Curated Collection</p>

    <h1>Resources</h1>

    <p class="subtitle">
      A growing collection of the books, AI tools, software,
      websites and resources I genuinely recommend to help you
      learn, build and grow.
    </p>

    <div class="stats">

      <div class="stat">
        <h3>100+</h3>
        <p>Resources</p>
      </div>

      <div class="stat">
        <h3>Free & Paid</h3>
        <p>Recommendations</p>
      </div>

      <div class="stat">
        <h3>Personally Curated</h3>
        <p>No Sponsored Lists</p>
      </div>

    </div>

  </div>

</section>

<section class="categories">

  <div class="container">

    <h2>Browse by Category</h2>

    <div class="grid">

      <a href="#" class="card">

        <h3>📚 Books</h3>

        <p>
          Timeless books that shaped my thinking,
          improved my mindset and helped me grow.
        </p>

      </a>

      <a href="#" class="card">

        <h3>🤖 AI Tools</h3>

        <p>
          The AI tools I use for writing,
          coding, brainstorming and productivity.
        </p>

      </a>

      <a href="#" class="card">

        <h3>⚡ Productivity</h3>

        <p>
          Apps and systems that help me stay
          organized, focused and consistent.
        </p>

      </a>

      <a href="#" class="card">

        <h3>💼 Business</h3>

        <p>
          Resources for entrepreneurs,
          freelancers and online creators.
        </p>

      </a>

      <a href="#" class="card">

        <h3>🎨 Design</h3>

        <p>
          Design software and creative
          tools for building beautiful projects.
        </p>

      </a>

      <a href="#" class="card">

        <h3>💻 Development</h3>

        <p>
          Hosting, coding tools and
          everything needed to build online.
        </p>

      </a>

    </div>

  </div>

</section>

<section class="featured">

  <div class="container">

    <h2>Featured Resources</h2>

    <p class="section-text">
      These are some of the tools I use regularly and recommend.
    </p>

    <div class="featured-grid">

      <div class="resource">

        <span class="tag">AI</span>

        <h3>ChatGPT</h3>

        <p>
          My daily assistant for research,
          writing, coding and learning.
        </p>

        <a href="#">Visit →</a>

      </div>

      <div class="resource">

        <span class="tag">Workspace</span>

        <h3>Notion</h3>

        <p>
          Notes, planning,
          projects and organization.
        </p>

        <a href="#">Visit →</a>

      </div>

      <div class="resource">

        <span class="tag">Design</span>

        <h3>Canva</h3>

        <p>
          Fast and beautiful graphics
          for websites and social media.
        </p>

        <a href="#">Visit →</a>

      </div>

      <div class="resource">

        <span class="tag">Development</span>

        <h3>Visual Studio Code</h3>

        <p>
          My favorite code editor
          for building websites.
        </p>

        <a href="#">Visit →</a>

      </div>

      <div class="resource">

        <span class="tag">Hosting</span>

        <h3>Cloudflare</h3>

        <p>
          Domains, DNS,
          security and performance.
        </p>

        <a href="#">Visit →</a>

      </div>

      <div class="resource">

        <span class="tag">Learning</span>

        <h3>GitHub</h3>

        <p>
          Open-source projects,
          collaboration and code hosting.
        </p>

        <a href="#">Visit →</a>

      </div>

    </div>

  </div>

</section>

<section class="quote">

  <div class="container">

    <blockquote>

      "Invest in tools that save you time,
      and books that change how you think."

    </blockquote>

  </div>

</section>

<section class="cta">

  <div class="container">

    <h2>Know a Great Resource?</h2>

    <p>
      I'm always looking for outstanding books,
      software and tools to recommend.
    </p>

    <a href="/contact" class="button">
      Suggest a Resource
    </a>

  </div>

</section>

</BaseLayout>

<style>

.hero{

padding:120px 0 90px;
text-align:center;

}

.eyebrow{

text-transform:uppercase;
letter-spacing:2px;
font-size:.85rem;
color:#777;
margin-bottom:1rem;

}

h1{

font-size:4rem;
margin-bottom:1.5rem;

}

.subtitle{

max-width:760px;
margin:auto;
color:#666;
font-size:1.15rem;
line-height:1.8;

}

.stats{

display:grid;
grid-template-columns:repeat(3,1fr);
gap:2rem;
margin-top:5rem;

}

.stat{

background:#fff;
border:1px solid #ECE7E0;
padding:2rem;
border-radius:18px;

}
.stat h3{

font-size:2rem;
margin-bottom:.5rem;

}

.stat p{

color:#666;

}

.categories{

padding:40px 0 120px;

}

.categories h2,
.featured h2,
.cta h2{

text-align:center;
font-size:2.7rem;
margin-bottom:1rem;

}

.grid{

display:grid;
grid-template-columns:repeat(3,1fr);
gap:2rem;

}

.card{

background:#fff;
border:1px solid #ECE7E0;
border-radius:18px;
padding:2rem;
transition:.25s ease;

}

.card:hover{

transform:translateY(-8px);
border-color:#d8d0c7;

}

.card h3{

margin-bottom:1rem;
font-size:1.45rem;

}

.card p{

color:#666;
line-height:1.8;

}

.featured{

padding:120px 0;

}

.section-text{

text-align:center;
max-width:700px;
margin:0 auto 4rem;
color:#666;

}

.featured-grid{

display:grid;
grid-template-columns:repeat(3,1fr);
gap:2rem;

}

.resource{

background:#fff;
border:1px solid #ECE7E0;
border-radius:18px;
padding:2rem;
transition:.25s ease;

}

.resource:hover{

transform:translateY(-8px);

}

.tag{

display:inline-block;
padding:.35rem .8rem;
border-radius:50px;
background:#F3EFEA;
font-size:.8rem;
margin-bottom:1.2rem;

}

.resource h3{

margin-bottom:1rem;

}

.resource p{

color:#666;
line-height:1.8;
margin-bottom:2rem;

}

.resource a{

font-weight:600;

}

.quote{

padding:120px 0;
text-align:center;

}

blockquote{

max-width:850px;
margin:auto;
font-size:2.2rem;
line-height:1.6;
font-family:"Cormorant Garamond",serif;

}

.cta{

padding:120px 0;
text-align:center;

}

.cta p{

max-width:700px;
margin:1.5rem auto 3rem;
color:#666;
line-height:1.8;

}

.button{

display:inline-block;
padding:16px 36px;
background:#111;
color:#fff;
border-radius:999px;
transition:.25s ease;

}

.button:hover{

opacity:.88;

}

@media(max-width:900px){

.grid{

grid-template-columns:repeat(2,1fr);

}

.featured-grid{

grid-template-columns:repeat(2,1fr);

}

}

@media(max-width:768px){

h1{

font-size:2.8rem;

}

.stats{

grid-template-columns:1fr;

}

.grid{

grid-template-columns:1fr;

}

.featured-grid{

grid-template-columns:1fr;

}

blockquote{

font-size:1.7rem;

}

section{

padding:80px 0;

}

}

</style>