---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact | TahaRb"
  description="Get in touch with Taha."
>

<section class="contact-hero">

  <div class="container narrow">

    <span class="eyebrow">
      CONTACT
    </span>

    <h1>
      Let's start a conversation.
    </h1>

    <p class="lead">
      Whether you have a question, feedback, a collaboration idea,
      or simply want to say hello, I'd be happy to hear from you.
    </p>

  </div>

</section>

<section class="contact-content">

  <div class="container contact-grid">

    <div class="contact-card">

      <h2>Email</h2>

      <p>
        The easiest way to reach me is by email.
        I do my best to reply as soon as possible.
      </p>

      <a href="mailto:hello@taharb.com">
        hello@taharb.com
      </a>

    </div>

    <div class="contact-card">

      <h2>Connect</h2>

      <p>
        Follow my journey, articles and future projects
        through my social platforms.
      </p>

      <ul>

        <li><a href="#">Facebook</a></li>

        <li><a href="#">LinkedIn</a></li>

        <li><a href="#">GitHub</a></li>

      </ul>

    </div>

  </div>

</section>

</BaseLayout>

<style>

.contact-hero{

    padding-top:120px;

}

.narrow{

    max-width:760px;

}

.eyebrow{

    letter-spacing:3px;

    font-size:.85rem;

    color:var(--text-light);

}

h1{

    font-size:clamp(3rem,7vw,5rem);

    margin:20px 0 30px;

}

.lead{

    font-size:1.2rem;

    line-height:2;

    color:var(--text-light);

}

.contact-content{

    padding:90px 0 120px;

}

.contact-grid{

    display:grid;

    grid-template-columns:repeat(2,1fr);

    gap:35px;

}

.contact-card{

    background:white;

    border:1px solid var(--border);

    border-radius:18px;

    padding:40px;

}

.contact-card h2{

    margin-bottom:18px;

}

.contact-card p{

    color:var(--text-light);

    line-height:1.9;

    margin-bottom:30px;

}

.contact-card a{

    font-weight:600;

    color:var(--text);

}

.contact-card ul{

    list-style:none;

    padding:0;

}

.contact-card li{

    margin-bottom:14px;

}

.contact-card li a{

    color:var(--text-light);

    transition:.25s;

}

.contact-card li a:hover{

    color:var(--text);

}

@media(max-width:768px){

.contact-grid{

grid-template-columns:1fr;

}

}

</style>