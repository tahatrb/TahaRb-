---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="TahaRb | Helping People Learn, Build & Grow"
  description="Self-development, AI, entrepreneurship, books and productivity."
>

<section class="hero">

  <div class="container">

    <p class="eyebrow">
      Founder • Builder • Lifelong Learner
    </p>

    <h1>
      Helping People
      <br />
      Learn, Build & Grow.
    </h1>

    <p class="subtitle">
      I share practical ideas on self-development,
      artificial intelligence, entrepreneurship,
      books and productivity to help people create
      a better future.
    </p>

    <div class="hero-buttons">

      <a href="/articles" class="primary">
        Explore Articles
      </a>

      <a href="/resources" class="secondary">
        Browse Resources
      </a>

    </div>

  </div>

</section>

<section class="topics">

  <div class="container">

    <h2>What You'll Find Here</h2>

    <div class="grid">

      <article class="card">

        <span>🧠</span>

        <h3>Self Development</h3>

        <p>
          Mindset, discipline,
          habits and personal growth.
        </p>

      </article>

      <article class="card">

        <span>🤖</span>

        <h3>Artificial Intelligence</h3>

        <p>
          AI tools,
          automation,
          prompts and workflows.
        </p>

      </article>

      <article class="card">

        <span>🚀</span>

        <h3>Entrepreneurship</h3>

        <p>
          Business ideas,
          freelancing,
          branding and online income.
        </p>

      </article>

      <article class="card">

        <span>📚</span>

        <h3>Books</h3>

        <p>
          Lessons,
          summaries
          and timeless recommendations.
        </p>

      </article>

      <article class="card">

        <span>⚡</span>

        <h3>Productivity</h3>

        <p>
          Systems,
          focus
          and better daily execution.
        </p>

      </article>

      <article class="card">

        <span>💻</span>

        <h3>Technology</h3>

        <p>
          Websites,
          software,
          coding and digital tools.
        </p>

      </article>

    </div>

  </div>

</section>

<section class="featured">

<div class="container">

<h2>Featured Resources</h2>

<p class="section-text">
Some of my favorite tools that I use regularly.
</p>

<div class="resources">

<div class="resource">

<h3>ChatGPT</h3>

<p>
Research, writing,
coding and brainstorming.
</p>

<a href="/resources">
Learn More →
</a>

</div>

<div class="resource">

<h3>Notion</h3>

<p>
Planning,
notes,
projects and organization.
</p>

<a href="/resources">
Learn More →
</a>

</div>

<div class="resource">

<h3>Visual Studio Code</h3>

<p>
My primary code editor
for web development.
</p>

<a href="/resources">
Learn More →
</a>

</div>

</div>

</div>

</section>

<section class="about-home">

<div class="container narrow">

<h2>About Taha</h2>

<p>

I'm passionate about learning,
building websites,
exploring AI
and sharing ideas that help people improve
their lives and careers.

This website is where I document that journey.

</p>

</div>

</section>

<section class="newsletter">

<div class="container narrow">

<h2>Join the Journey</h2>

<p>

Receive future articles,
resources
and practical insights.

</p>

<form>

<input
type="email"
placeholder="Your email address"
/>

<button>

Subscribe

</button>

</form>

</div>

</section>

<section class="cta">

<div class="container">

<h2>

Ready to Start Learning?

</h2>

<p>

Explore articles,
discover new resources
and keep building every day.

</p>

<div class="hero-buttons">

<a href="/articles" class="primary">

Read Articles

</a>

<a href="/resources" class="secondary">

Resources

</a>

</div>

</div>

</section>

</BaseLayout>

<style>

.hero{

padding:140px 0 120px;
text-align:center;

}

.eyebrow{

letter-spacing:2px;
text-transform:uppercase;
font-size:.85rem;
color:#777;
margin-bottom:1rem;

}

h1{

font-size:4.5rem;
line-height:1.1;
margin-bottom:2rem;

}

.subtitle{

max-width:760px;
margin:auto;
font-size:1.2rem;
line-height:1.9;
color:#666;

}

.hero-buttons{

display:flex;
justify-content:center;
gap:1rem;
margin-top:3rem;
flex-wrap:wrap;

}

.primary{

background:#111;
color:white;
padding:16px 34px;
border-radius:999px;

}

.secondary{

border:1px solid #111;
padding:16px 34px;
border-radius:999px;

}
.topics{

padding:120px 0;

}

.topics h2,
.featured h2,
.about-home h2,
.newsletter h2,
.cta h2{

text-align:center;
font-size:2.8rem;
margin-bottom:1rem;

}

.grid{

display:grid;
grid-template-columns:repeat(3,1fr);
gap:2rem;
margin-top:4rem;

}

.card{

background:#fff;
border:1px solid #ECE7E0;
border-radius:18px;
padding:2rem;
transition:.25s ease;

}

.card:hover{

transform:translateY(-8px);

}

.card span{

font-size:2rem;
display:block;
margin-bottom:1rem;

}

.card h3{

margin-bottom:1rem;

}

.card p{

color:#666;
line-height:1.8;

}

.featured{

padding:120px 0;

}

.section-text{

text-align:center;
color:#666;
max-width:650px;
margin:0 auto 4rem;

}

.resources{

display:grid;
grid-template-columns:repeat(3,1fr);
gap:2rem;

}

.resource{

background:#fff;
border:1px solid #ECE7E0;
border-radius:18px;
padding:2rem;
transition:.25s ease;

}

.resource:hover{

transform:translateY(-8px);

}

.resource h3{

margin-bottom:1rem;

}

.resource p{

color:#666;
line-height:1.8;
margin-bottom:2rem;

}

.resource a{

font-weight:600;

}

.about-home{

padding:120px 0;
text-align:center;

}

.narrow{

max-width:760px;

}

.about-home p{

font-size:1.1rem;
line-height:2;
color:#666;

}

.newsletter{

padding:120px 0;
text-align:center;

}

form{

display:flex;
justify-content:center;
gap:1rem;
margin-top:3rem;
flex-wrap:wrap;

}

input{

width:380px;
max-width:100%;
padding:18px;
border:1px solid #ddd;
border-radius:999px;
font:inherit;
background:white;

}

button{

padding:18px 36px;
background:#111;
color:white;
border:none;
border-radius:999px;
cursor:pointer;
transition:.25s ease;

}

button:hover{

opacity:.9;

}

.cta{

padding:140px 0;
text-align:center;

}

.cta p{

max-width:650px;
margin:1.5rem auto 3rem;
line-height:1.9;
color:#666;

}

.primary:hover,
.secondary:hover,
button:hover{

transform:translateY(-2px);

}

@media(max-width:900px){

.grid{

grid-template-columns:repeat(2,1fr);

}

.resources{

grid-template-columns:repeat(2,1fr);

}

}

@media(max-width:768px){

section{

padding:80px 0;

}

h1{

font-size:3rem;

}

.hero{

padding:100px 0 80px;

}

.grid{

grid-template-columns:1fr;

}

.resources{

grid-template-columns:1fr;

}

.hero-buttons{

flex-direction:column;
align-items:center;

}

.primary,
.secondary{

width:260px;
text-align:center;

}

input{

width:100%;

}

button{

width:100%;

}

}

</style>