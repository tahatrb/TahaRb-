---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: {
      slug: post.id,
    },
    props: {
      post,
    },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={`${post.data.title} | TahaRb`}
  description={post.data.description}
>
  <main class="article-page">

    <article class="article">

      <header class="article-header">

        <p class="category">
          {post.data.category}
        </p>

        <h1>{post.data.title}</h1>

        <p class="description">
          {post.data.description}
        </p>

        <div class="meta">
          <span>By {post.data.author}</span>
          <span>•</span>
          <span>
            {post.data.pubDate.toLocaleDateString()}
          </span>
        </div>

      </header>

      <div class="article-content">
        <Content />
      </div>

    </article>

  </main>
</BaseLayout>

<style>
.article-page {
  max-width: 900px;
  margin: 0 auto;
  padding: 100px 24px;
}

.article {
  width: 100%;
}

.article-header {
  text-align: center;
  margin-bottom: 70px;
}

.category {
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  font-weight: 600;
  margin-bottom: 20px;
}

.article-header h1 {
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(3rem, 7vw, 5.5rem);
  line-height: 0.95;
  margin: 0 auto 25px;
  max-width: 850px;
}

.description {
  font-size: 1.15rem;
  line-height: 1.7;
  max-width: 700px;
  margin: 0 auto 25px;
}

.meta {
  display: flex;
  justify-content: center;
  gap: 10px;
  font-size: 0.9rem;
  opacity: 0.65;
}

.article-content {
  font-size: 1.08rem;
  line-height: 1.85;
  max-width: 760px;
  margin: 0 auto;
}

.article-content :global(h2) {
  font-family: "Cormorant Garamond", serif;
  font-size: 2.3rem;
  margin-top: 60px;
  margin-bottom: 20px;
}

.article-content :global(h3) {
  font-family: "Cormorant Garamond", serif;
  font-size: 1.8rem;
  margin-top: 45px;
  margin-bottom: 15px;
}

.article-content :global(p) {
  margin-bottom: 25px;
}

.article-content :global(ul),
.article-content :global(ol) {
  margin: 25px 0;
  padding-left: 30px;
}

.article-content :global(li) {
  margin-bottom: 10px;
}

.article-content :global(a) {
  text-decoration: underline;
}

.article-content :global(blockquote) {
  border-left: 3px solid currentColor;
  padding-left: 25px;
  margin: 40px 0;
  font-family: "Cormorant Garamond", serif;
  font-size: 1.5rem;
  font-style: italic;
}

.article-content :global(img) {
  max-width: 100%;
  height: auto;
  border-radius: 16px;
  margin: 35px 0;
}

@media (max-width: 700px) {
  .article-page {
    padding: 70px 20px;
  }

  .article-header h1 {
    font-size: 3rem;
  }

  .meta {
    flex-wrap: wrap;
  }

  .article-content {
    font-size: 1rem;
  }
}
</style>