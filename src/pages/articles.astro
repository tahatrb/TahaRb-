---
import BaseLayout from "../layouts/BaseLayout.astro";
import Search from "../components/Search.astro";
import { getCollection } from "astro:content";

const posts = await getCollection(
  "blog",
  ({ data }) => !data.draft
);

posts.sort(
  (a, b) =>
    b.data.pubDate.getTime() -
    a.data.pubDate.getTime()
);
---

<BaseLayout
  title="Articles | TahaRb"
  description="Read the latest articles from TahaRb."
>

  <section class="container">

    <h1>Articles</h1>

    <p>
      Thoughts on self-development, AI, business and productivity.
    </p>

    <Search />

    <div class="posts">

      {
        posts.map((post) => (

          <article
            class="card"
            data-searchable
          >

            <span class="category">
              {post.data.category}
            </span>

            <h2>
              <a href={`/articles/${post.id}/`}>
                {post.data.title}
              </a>
            </h2>

            <p>
              {post.data.description}
            </p>

            <small>
              By {post.data.author}
              •
              {post.data.pubDate.toLocaleDateString()}
            </small>

          </article>

        ))
      }

    </div>

  </section>

</BaseLayout>


<style>

.posts {

  display: grid;

  gap: 2rem;

  margin-top: 3rem;

}


.card {

  padding: 2rem;

  border:
    1px solid #e5e5e5;

  border-radius:
    16px;

}


.card h2 {

  margin:
    .6rem 0 1rem;

}


.card h2 a {

  transition:
    opacity .25s ease;

}


.card h2 a:hover {

  opacity: .65;

}


.card p {

  margin-bottom:
    1rem;

}


.category {

  display: inline-block;

  font-size: .8rem;

  letter-spacing: .08em;

  text-transform: uppercase;

  color: #6B6B6B;

}


.card small {

  color: #777;

}

</style>